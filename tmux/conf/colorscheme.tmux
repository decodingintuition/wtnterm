# noita
set -g @dark        "#111217"   # mines    – primary background
set -g @darker      "#010101"   # void     – secondary / terminal bg
set -g @darkest     "#111217"   # mines    – status bar fill
set -g @dark_gray   "#20222d"   # wasteland – elevated surface
set -g @med_gray    "#928991"   # muted    – border accent
set -g @light_gray  "#879e9a"   # water    – dimmed text
set -g @pale_gray   "#253138"   # base     – selection and inactive badges
set -g @bright_text "#c7c7c7"   # bone     – default foreground
set -g @blue        "#6895f3"   # mana     – keyword / head1
set -g @green       "#92b71c"   # sludge   – green
set -g @yellow      "#d5ab34"   # ambrosia – warm yellow
set -g @red         "#e47b7a"   # blood    – error
set -g @purple      "#f16d9d"   # fungus   – active badges
set -g @orange      "#f87d01"   # lava     – warning
set -g @cyan        "#85c6c6"   # tele     – cyan
